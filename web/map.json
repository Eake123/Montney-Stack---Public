  "capacity_words": {
    "_doc": "PLAN 10c: a plant's capacity series in its source's own word (longest series-id prefix wins), e.g. the panel's \"Out of service (IESO capability 0)\". Unmatched: \"capacity\", not live. `live`: the series is availability published hour by hour (IESO capability), so 0 MW against it reads \"Idle, available\"; a static rating (AESO MC: one value for months; NRC net summer capacity) can't say that, so 0 MW reads \"Not producing\" (Reviewer on #539: Palisades 0 of 768.5 MW for 30 days, restarting). `zero`: the source's own words for a zero reading.",
    "ieso.": { "word": "IESO capability", "live": true },
    "aeso.": { "word": "AESO max capability", "live": false },
    "nrc.": { "word": "net summer capacity", "live": false, "zero": "0 % on NRC's daily report" }
  },
  "producers": {
    "_doc": "L-075 (Erik): a panel showing one of these series offers a 'Top producers' popup for the province (web/producers.js, Gas's /api/top-producers).",
    "production.ab.daily_est": "ab",
    "production.bc.daily_est": "bc"
  },
  "tieouts": {
    "_doc": "L-079 (Erik): a panel showing one of these series adds the tie-out view (web/tieout.js). Gas #296: every term MMcf/d, NGTL gas day, stored positive unless noted; storage + = withdrawal. left over + actual storage = the metered residual, ≈ 0 when AB + BC ties out.",
    "ngtl.csr.net_storage": {
      "title": "AB + BC tie-out check",
      "day_of": "balance.ab_bc.residual_est",
      "preliminary_hours": 48,
      "days": 30,
      "unit": "MMcf/d",
      "bars": [
        {
          "series": "balance.ab_bc.production_est",
          "label": "AB + BC production",
          "sign": 1
        },
        {
          "series": [
            "production.ab.other_est",
            "production.bc.other_est"
          ],
          "label": "− demand off NGTL (carried)",
          "sign": -1
        },
        {
          "series": "export.pipeline.total_est",
          "label": "− exports: pipelines",
          "sign": -1
        },
        {
          "series": "lng.export.total",
          "label": "− exports: LNG",
          "sign": -1
        },
        {
          "series": "ngtl.gdsr.intraprovincial.flow",
          "label": "− AB demand on NGTL",
          "sign": -1
        }
      ],
      "left_label": "= left over (+ into storage, − out of it)",
      "storage": [
        {
          "series": "ngtl.gdsr.net_storage.flow",
          "label": "NGTL storage (net, + = withdrawal)"
        },
        {
          "series": "westcoast.oa.aitken_storage_est",
          "label": "Aitken Creek (net, + = withdrawal)"
        }
      ],
      "storage_label": "= actual storage (NGTL + Aitken)",
      "residual": {
        "series": "balance.ab_bc.residual_metered_est",
        "band": "balance.ab_bc.metered_band_est",
        "label": "Tie-out error (left over + actual storage)"
      },
      "raw": {
        "series": "balance.ab_bc.residual_est",
        "band": "balance.ab_bc.band_est",
        "label": "Tie-out error before the carried demand off NGTL",
        "breakdown": {
          "_doc": "L-080 item 4 (Erik: \"Include the estimation when I click the unaccounted for amount and what it assumes it is\"). Gas #313 (4b680d2): daily, NGTL gas day, MMcf/d; the five parts sum exactly to balance.ab_bc.residual_est; + = adds to the error. Full assumptions: docs/research/gas-residual.md §8.",
          "title": "Where the tie-out error goes",
          "sum_label": "= tie-out error",
          "parts": [
            { "series": "balance.ab.unaccounted.ab_offsystem_est", "confidence": "high total, medium split", "label": "AB gas sold off NGTL and Alliance", "band_rel": 0.4,
              "assume": "AB sales gas off NGTL and Alliance, from the latest Petrinex month (~2 months back), carried; each plant goes to its nearest active meter station's pipeline; ATCO stations TC counts as NGTL receipts are excluded. ±40 % for that attribution.",
              "parts": [
                { "series": "balance.ab.unaccounted.gas_alberta_est", "confidence": "medium-high", "label": "Gas Alberta (rural co-ops)", "band_rel": 0.4 },
                { "series": "balance.ab.unaccounted.atco_pipelines_est", "confidence": "medium", "label": "ATCO Pipelines (outside NGTL's receipts)", "band_rel": 0.4 },
                { "series": "balance.ab.unaccounted.tc_mainline_suffield_est", "confidence": "high", "label": "AEC Suffield → TC Mainline (an export)", "band_rel": 0.4 },
                { "series": "balance.ab.unaccounted.pioneer_brazeau_est", "confidence": "low (where it goes)", "label": "Pioneer Brazeau (destination unknown)", "band_rel": 0.4 },
                { "series": "balance.ab.unaccounted.suncor_albersun_est", "confidence": "medium-high", "label": "Suncor Albersun (oil sands, direct)", "band_rel": 0.4 },
                { "series": "balance.ab.unaccounted.altagas_cold_lake_est", "confidence": "medium", "label": "AltaGas Cold Lake", "band_rel": 0.4 },
                { "series": "balance.ab.unaccounted.other_systems_est", "confidence": "medium", "label": "Other systems (ICG, Medicine Hat, Montana, …)", "band_rel": 0.4 }
              ] },
            { "series": "balance.ab.unaccounted.ngtl_basis_est", "confidence": "high", "label": "NGTL measurement basis", "band": 50,
              "assume": "TC's meters read ~3 % above NGTL's GDSR (likely NGTL fuel and unaccounted gas): (k − 1) × GDSR field receipts that day, k = TC measured ÷ GDSR for the latest full month. ±50." },
            { "series": "balance.ab.unaccounted.ngtl_closure", "confidence": "high", "label": "NGTL's own books that day (linepack)", "measured": true,
              "assume": "What NGTL's GDSR doesn't close that day: linepack and GDSR rounding (80 % of days over 5 years fall between about −260 and +320, so a big day isn't an error). Measured." },
            { "series": "balance.ab.unaccounted.bc_remainder_est", "confidence": "medium", "label": "BC remainder", "band": 300,
              "assume": "BC meters above BCER plant outlets, including NW-Alberta gas in Alliance Zone 1 (usually negative). ±300." },
            { "series": "balance.ab.unaccounted.unexplained_est", "label": "Unexplained", "band_series": "balance.ab.unaccounted.unexplained_band_est",
              "assume": "What the parts above don't account for." }
          ],
          "history": {
            "title": "AB sales gas by destination (est.: nearest meter station, ±40 %) · Petrinex volumes, monthly",
            "months": true,
            "series": [
              { "series": "petrinex.ab.sales_to.gas_alberta", "label": "Gas Alberta" },
              { "series": "petrinex.ab.sales_to.atco_pipelines", "label": "ATCO Pipelines" },
              { "series": "petrinex.ab.sales_to.tc_mainline_suffield", "label": "Suffield → TC" },
              { "series": "petrinex.ab.sales_to.pioneer_brazeau", "label": "Pioneer Brazeau" },
              { "series": "petrinex.ab.sales_to.suncor_albersun", "label": "Suncor Albersun" },
              { "series": "petrinex.ab.sales_to.altagas_cold_lake", "label": "AltaGas Cold Lake" },
              { "series": "petrinex.ab.sales_to.other_systems", "label": "Other systems" },
              { "series": "petrinex.ab.sales_to.unattributed", "label": "Unattributed" }
            ]
          },
          "report": { "url": "https://github.com/Eake123/Montney-Stack/blob/main/docs/research/gas-residual.md", "label": "Full report: where the ~1.25 Bcf/d goes",
            "summary": "About three quarters is real AB gas that goes off NGTL in Alberta (rural co-ops, ATCO, Suffield into the TC Mainline, oil sands); most of the rest is NGTL's own measurement basis (TC's meters read ~3 % above GDSR). Over Nov 2025 to Sep 2026 the parts left ~+8 MMcf/d unexplained (sd ~53)." },
          "note": "+ adds to the error. The off-NGTL parts lag: Petrinex reports about two months back, so the latest month is carried. Full assumptions: docs/research/gas-residual.md §8."
        }
      },
      "chart": [
        {
          "series": "balance.ab_bc.implied_storage_est",
          "label": "implied storage",
          "history": "balance.ab_bc.implied_storage_monthly"
        },
        {
          "series": "balance.ab_bc.storage_actual",
          "label": "actual (NGTL + Aitken)",
          "history": "balance.ab_bc.storage_actual_monthly"
        },
        {
          "series": "balance.ab_bc.residual_est",
          "history": "balance.ab_bc.residual_monthly",
          "label": "tie-out error (before carried)",
          "dash": [
            4,
            3
          ]
        }
      ],
      "note": "It ties out when the error is within its band. Storage: + = withdrawal. The chart is monthly history (Gas, to the latest regulator month) then daily from 2026-11-01; implied storage there excludes the carried demand off NGTL, so its error runs ≈ +1.25 Bcf/d.",
      "history_days": 1100
    }
  },
